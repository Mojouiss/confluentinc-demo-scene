# Environment variables configuration example
# Copy this file to .env and update with your values

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICS=["financial-positions"]  # JSON array
KAFKA_GROUP_ID=financial-snapshot-consumer
KAFKA_NUM_CONSUMERS=3
KAFKA_LOAD_OFFSETS_FROM_SQL=true
KAFKA_OFFSETS_TABLE=KafkaOffsets

# SQL Server Configuration
SQL_SERVER=localhost
SQL_DATABASE=FinanceDB
SQL_USERNAME=sa
SQL_PASSWORD=YourStrongPassword123
SQL_PORT=1433
SQL_CONNECTION_POOL_SIZE=5
SQL_BATCH_SIZE=1000

# Snapshot Configuration
SNAPSHOT_INTERVAL_SECONDS=300
SNAPSHOT_BUFFER_SIZE=100000

# Handler Configuration
HANDLER_DEFAULT_HANDLER_TYPE=financial_position
HANDLER_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
